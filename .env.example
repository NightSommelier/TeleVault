APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=info
HTTP_ADDR=:8080
POSTGRES_DB=televaultdb
POSTGRES_USER=televaultuser
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgres://televaultuser:replace-with-postgres-password@postgres:5432/televaultdb?sslmode=disable
VALKEY_ADDR=valkey:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
SECURE_COOKIE=false
COOKIE_SAME_SITE=Lax

AUTH_RATE_LIMIT_ENABLED=true
TELEGRAM_AUTH_IP_LIMIT_PER_MINUTE=30
TELEGRAM_SEND_CODE_PHONE_LIMIT_PER_HOUR=5
TELEGRAM_LOGIN_PHONE_LIMIT_PER_HOUR=10

# Generate real high-entropy values before running anything beyond local smoke tests.
APP_SESSION_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-characters

# Must be a real age identity before uploads are enabled.
APP_AGE_IDENTITY=AGE-SECRET-KEY-replace-with-real-age-secret-key

# Generate with: openssl rand -base64 32
TELEGRAM_SESSION_KEY=replace-with-base64-32-byte-key

TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash

# Application-level Telegram document sizing. Keep part size + margin under the
# account's effective Telegram document limit.
UPLOAD_PART_SIZE_BYTES=402653184
TELEGRAM_DOCUMENT_LIMIT_BYTES=2147483648
UPLOAD_SAFETY_MARGIN_BYTES=67108864
UPLOAD_STAGING_DIR=/data/upload-staging
